{
  "name": "base32-key",
  "version": "3.1.0",
  "description": "Human-friendly base 32 keys with per-group check digits: product keys, voucher codes, serial numbers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./browser": "./dist/base32-key.min.js",
    "./test-vectors.json": "./test-vectors.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "base32-key": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "test-vectors.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhquan/base32-key.git"
  },
  "homepage": "https://ducminhquan.github.io/base32-key/",
  "license": "MIT",
  "keywords": [
    "base32",
    "serial-key",
    "product-key",
    "cd key",
    "voucher",
    "Crockford",
    "checksum",
    "crc5"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "spell": "cspell --no-progress \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run spell && npm run test:unit && npm run build && npm run test:package",
    "test:unit": "vitest run --coverage",
    "test:package": "attw --pack . --profile node16 --exclude-entrypoints ./element ./browser ./test-vectors.json && attw --pack . --profile esm-only --entrypoints ./element && size-limit && node scripts/smoke.mjs",
    "watch": "vitest",
    "doc": "typedoc",
    "site": "npm run build && npm run doc && node scripts/site.mjs",
    "bump": "commit-and-tag-version --skip.tag",
    "release": "commit-and-tag-version && git push --follow-tags origin master",
    "bench": "npm run build && node scripts/bench.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "commit-and-tag-version": "^13.3.0",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.11.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "tinybench": "^6.2.4",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "unpkg": "./dist/base32-key.min.js",
  "jsdelivr": "./dist/base32-key.min.js",
  "size-limit": [
    {
      "name": "browser build (minified)",
      "path": "dist/base32-key.min.js",
      "limit": "7 kB"
    },
    {
      "name": "core library (ESM)",
      "path": "dist/index.js",
      "limit": "8 kB"
    }
  ]
}
